# Set this to the public HTTPS URL of the backend when deploying on Vercel.
# Leave unset locally to use Vite's /api and /uploads development proxy.
VITE_API_ORIGIN=https://your-api.onrender.com
VITE_AI_SERVICE_ORIGIN=https://roomora-9wyb.onrender.com
# Optional override for Roomora's built-in public Google OAuth web client ID.
VITE_GOOGLE_CLIENT_ID=
