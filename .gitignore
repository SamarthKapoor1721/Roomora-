# ─────────────────────────────────────────────────────────────
#  Roomora — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
jspm_packages/
bower_components/

# Python virtual environments
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
pip-log.txt
pip-wheel-metadata/

# ── Environment / secrets ─────────────────────────────────────
.env
.env.*
!.env.example
*.env
!*.env.example
.envrc
.direnv/
# service-specific
backend/.env
ai-service/.env
frontend/.env
# key material
*.pem
*.key
*.p8
*.p12
*.pfx
*.crt
*.cer
secrets.json
credentials.json
*-credentials.json
*service-account*.json
.npmrc
.pypirc
.netrc

# ── Build output ──────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
*.tsbuildinfo
frontend/dist/
backend/dist/

# ── Prisma / database ─────────────────────────────────────────
# migrations ARE committed; ignore local sqlite files & generated client
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/dev.db*
prisma/generated/
.prisma/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ── Local Postgres data (if bind-mounted) ─────────────────────
pgdata/
postgres-data/
*.sql.bak

# ── Uploaded files (keep the folder, ignore its contents) ─────
backend/uploads/*
!backend/uploads/.gitkeep
uploads/

# ── Logs & runtime ────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Testing / coverage ────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
.pytest_cache/
.coverage
.coverage.*
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.tox/
.cache/
test-results/
playwright-report/
.vitest/

# ── Caches ────────────────────────────────────────────────────
.eslintcache
.stylelintcache
.parcel-cache/
.vite/
*.tgz
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ── Editors / IDEs ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ── OS cruft ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Office / document temp files ──────────────────────────────
~$*.docx
~$*.xlsx
~$*.pptx
.~lock.*#

# ── Misc project artifacts ────────────────────────────────────
tmp/
temp/
scratch/
*.local

# Docker / compose overrides (keep the base file)
docker-compose.override.yml
docker-compose.*.local.yml

# Hosting provider local state (keep render.yaml and vercel.json)
.vercel/
.render/
.netlify/
.serverless/
