# NVIDIA NIM API (primary AI provider) — OpenAI-compatible endpoint.
# Get a key at https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k3

# Reasoning depth for reasoning-capable models: low | medium | high | max
NVIDIA_NIM_REASONING_EFFORT=low
NVIDIA_NIM_TEMPERATURE=0.4

# NVIDIA-hosted reasoning models are slow. "blocking" calls (tenant is waiting
# in a synchronous flow) fall back fast; "interactive" calls (owner actions,
# chat assistant) wait longer. Seconds.
AI_TIMEOUT_BLOCKING=18
AI_TIMEOUT_INTERACTIVE=90
AI_MAX_RETRIES=0

# Service
PORT=8001
