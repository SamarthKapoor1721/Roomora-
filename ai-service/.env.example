# NVIDIA NIM API (primary AI provider) — OpenAI-compatible endpoint.
# Get a key at https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick a model your key can actually invoke. openai/gpt-oss-20b is the fastest
# that works broadly (~10-15s). Others: nvidia/nemotron-3-super-120b-a12b,
# moonshotai/kimi-k3 (slow). Many older meta/mistral models are retired (410).
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
NVIDIA_NIM_TEMPERATURE=0.3
# Only for DeepSeek-style reasoning models: low | medium | high | max
# NVIDIA_NIM_REASONING_EFFORT=low

# Per-call timeout (seconds). "blocking" = tenant waiting in a sync flow
# (screening); "interactive" = owner action / chat assistant.
AI_TIMEOUT_BLOCKING=35
AI_TIMEOUT_INTERACTIVE=60
AI_MAX_RETRIES=0

# Service
PORT=8001
