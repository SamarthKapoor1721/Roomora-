# NVIDIA NIM API (primary AI provider) — OpenAI-compatible endpoint.
# Get a key at https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick a model your key can actually invoke. nvidia/nemotron-3.5-lightning-30b-a3b
# (~14s with thinking off) is the default; nvidia/nemotron-3-super-120b-a12b (~20s)
# and openai/gpt-oss-20b (~12s) also work. Many older meta/mistral models are
# retired (410).
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_TEMPERATURE=0.3
# Nemotron 3.5 leaks its reasoning into the answer unless thinking is off.
NVIDIA_NIM_THINKING=false
# Only for DeepSeek-style reasoning models: low | medium | high | max
# NVIDIA_NIM_REASONING_EFFORT=low

# Per-call timeout (seconds). "blocking" = tenant waiting in a sync flow
# (screening); "interactive" = owner action / chat assistant.
AI_TIMEOUT_BLOCKING=40
AI_TIMEOUT_INTERACTIVE=60
AI_MAX_RETRIES=1

# Service
PORT=8001
