# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Production: set this to the frontend's HTTPS origin (comma-separate trusted origins).

# Database
# Use an Atlas replica set and include the database name.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>/srms?retryWrites=true&w=majority"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# AI service
AI_SERVICE_URL=http://localhost:8001
# Render Blueprint provides AI_SERVICE_HOSTPORT instead of AI_SERVICE_URL.
AI_SERVICE_TIMEOUT_MS=130000
